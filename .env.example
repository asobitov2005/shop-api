# Local Docker defaults. Keep database URLs in sync if changing DB credentials.
PYTHON_VERSION=3.12-slim
UV_VERSION=0.10.8
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
API_PORT=8000
API_HOST_PORT=58000
POSTGRES_HOST_PORT=55433
REDIS_HOST_PORT=56380
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
TEST_DATABASE_URL=postgresql+psycopg://app:app@db:5432/app_test
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1
TASK_WEBHOOK_SECRET=local-task-webhook-secret
APP_ROOT_PATH=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_RETURN_URL=
